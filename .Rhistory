pivot_longer(
cols = c(MAPS_Pre_OverallExpertise, MAPS_Post_OverallExpertise),
names_to = "Time",
values_to = "Score"
) %>%
mutate(
Time = recode(
Time,
"MAPS_Pre_OverallExpertise" = "Pre",
"MAPS_Post_OverallExpertise" = "Post"
),
Time = factor(Time, levels = c("Pre", "Post")),
InstructionType = ifelse(InstructionType == 0, "Traditional", "ISF"),
InstructionType = factor(InstructionType, levels = c("Traditional", "ISF"))) %>%
group_by(InstructionType, Time) %>%
summarise(
mean = mean(Score, na.rm = TRUE),
se = sd(Score, na.rm = TRUE) / sqrt(n()),
ci_low = mean - qt(0.975, df = n() - 1) * se,
ci_high = mean + qt(0.975, df = n() - 1) * se,
.groups = "drop")
ggplot(expertise_data,
aes(x = InstructionType,y = mean,color = Time,shape = Time)) +
geom_errorbar(aes(ymin = ci_low, ymax = ci_high),
position = position_dodge(width = 0.45),
width = 0.12,
linewidth = 1) +
geom_point(position = position_dodge(width = 0.45),size = 4) +
scale_color_manual(
values = c(
"Pre"  = "#0072B2",  # Okabe-Ito blue
"Post" = "#E69F00"   # Okabe-Ito orange
)
) +
scale_shape_manual(
values = c(
"Pre"  = 15,  # square
"Post" = 17   # triangle
)
) +
scale_y_continuous(limits = c(8, NA),
breaks = seq(8, 20, by = 2),
labels = function(x) round(x, 0)) +
labs(x = NULL,y = "Mean Expertise Score",color = NULL,shape = NULL) +
theme_classic(base_size = 17) +
theme(axis.title.y = element_text(face = "bold"),
axis.text.x = element_text(face = "bold",size = 15),
legend.position = "right",
legend.text = element_text(size = 15),
panel.grid.major.y = element_line(color = "grey85",linewidth = 0.5),
panel.grid.minor.y = element_blank())
ggsave(last_plot(),file="~/Documents/Tarleton/Brently_Figures/figure2.png")
